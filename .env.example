# ============================================================
# Azoramind Tareo — variables de entorno
# Copiar como `.env` (gitignored) y completar con valores reales.
# ============================================================

# --- Base de datos ---
# Formato: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/azoramind_tareo

# --- Auth (JWT) ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generar_con_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
APP_NAME=Azoramind Tareo
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=America/Lima

# --- CORS ---
# Coma-separado. En prod usar dominios reales, en dev localhost.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite build-time) ---
# Se inyecta al frontend en build. En prod apuntar al dominio del backend.
VITE_API_BASE_URL=http://localhost:8000
