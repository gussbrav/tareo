# Auto-detect text vs binary
* text=auto eol=lf

# Force LF for anything shell-executed on Linux (Docker, EasyPanel)
Dockerfile   text eol=lf
*.sh         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# Python / JS
*.py         text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.json       text eol=lf
*.sql        text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.md         text eol=lf

# Binaries
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
